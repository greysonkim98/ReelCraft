# Backend only (read by backend/src/config/env.ts). Copy this file to .env and fill it in.
# Frontend values (NEXT_PUBLIC_*) go in frontend/.env.local, not here.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the app (Render: 1). Check it before enabling IP_DAILY_CAP.
TRUST_PROXY_HOPS=1

# Groq (https://console.groq.com/keys). Never expose this to the browser, never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# One request per project. With frame images it goes to this vision model (check the Groq console: the list changes)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Firebase project id
FIREBASE_PROJECT_ID=reelcraft-4a7a7
# Service account key (JSON or base64 JSON) for hosts outside Google Cloud, such as Render.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local development without Firestore: keep counters in memory (forbidden in production).
STORE=memory
# Local development with the Auth emulator (see docs/local-testing.md):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Daily limits. The service-wide cap protects Groq's free tier (200K tokens/day for everyone).
AI_PER_USER_PER_DAY=3
GLOBAL_DAILY_AI_CAP=60
# 0 disables the per-IP cap. Enable only after checking req.ip behind the host's proxy.
IP_DAILY_CAP=0
IP_HASH_SALT=
