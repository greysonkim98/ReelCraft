# Backend (repo-root .env, read by backend/src/config/env.ts). Copy this file to .env and fill it in.
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:3000
# 0 for a direct local connection; Render: 1. Never trust client-supplied forwarding headers directly.
TRUST_PROXY_HOPS=0

# Groq (https://console.groq.com/keys). Never expose this to the browser, never commit it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Firebase project id
FIREBASE_PROJECT_ID=reelcraft-4a7a7
# Service account key (JSON or base64 JSON) for hosts outside Google Cloud, such as Render.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local development without Firestore: keep counters in memory (forbidden in production).
STORE=memory
# Local development with the Auth emulator (see docs/local-testing.md):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Daily limits. The service-wide cap protects Groq's free tier (200K tokens/day for everyone).
AI_PER_USER_PER_DAY=3
GLOBAL_DAILY_AI_CAP=60
# 0 disables the per-IP cap. Enable only after checking req.ip behind the host's proxy.
IP_DAILY_CAP=0
IP_HASH_SALT=

# IPinfo Lite: https://ipinfo.io/dashboard/token (backend only).
# Set IP_HASH_SALT to a stable random secret before enabling this integration.
IPINFO_TOKEN=
# Optional comma-separated ASN watchlist, e.g. AS15169 for a controlled test only.
# Lite does not supply VPN/datacenter detection. Empty means no ASN step-up checks.
IPINFO_FLAGGED_ASNS=
# Required with the watchlist: same public app ID as NEXT_PUBLIC_FIREBASE_APP_ID.
FIREBASE_WEB_APP_ID=

# Frontend (public values only; read at build time, see frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=reelcraft-4a7a7
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase App Check / reCAPTCHA v3, used on /verify. Register the app in Firebase first.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Shown on /terms and /privacy
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Never set this in a production build: it adds a sign-in button that skips Google.
# NEXT_PUBLIC_AUTH_EMULATOR=127.0.0.1:9099
